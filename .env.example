# Neon PostgreSQL Connection URLs
# Pooler URL for pooled connections (Next.js serverless / edge)
DATABASE_URL="postgresql://neondb_owner:npg_xxxx@ep-cool-flower-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct URL for Prisma migrations
DIRECT_URL="postgresql://neondb_owner:npg_xxxx@ep-cool-flower-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth Session Secret
AUTH_SECRET="super-secret-random-key-change-this-in-production-min-32-chars"

# Initial Admin Credentials (used during seed)
ADMIN_NAME="Admin Paris Decoration"
ADMIN_EMAIL="admin@parisdecoration.com"
ADMIN_PASSWORD="AdminParisDeco2026!#"

# Google Apps Script & Google Drive Image Upload Integration
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbxYOUR_SCRIPT_ID/exec"
GOOGLE_DRIVE_UPLOAD_SECRET="secret_token_paris_upload"

# Public Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
